generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  country      String?
  referralCode String         @unique
  referredById String?
  role         UserRole       @default(USER)
  status       UserStatus     @default(ACTIVE)
  points       Int            @default(0)
  resetToken   String?        @unique
  resetTokenExpires DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  twoFactorSecret   String?
  twoFactorEnabled  Boolean   @default(false)

  // ✅ Balances
  walletBalance    Float   @default(0)
  lockedBonus      Float   @default(0)
  lockedRewards    Float   @default(0)
  totalReleased    Float   @default(0)

  // ✅ Purchase & Reward Tracking
  totalPurchased   Float   @default(0)
  totalRewards     Float   @default(0)
  isEligible       Boolean @default(false)

  // Relations
  referredBy       User?                 @relation("UserReferrals", fields: [referredById], references: [id])
  referrals        User[]                @relation("UserReferrals")
  sessions         Session[]
  pointLedger      PointLedger[]
  activities       UserActivity[]
  purchases        Purchase[]            @relation("UserPurchases")
  rewardsEarned    RewardDistribution[]  @relation("Earner")
  rewardsGenerated RewardDistribution[]  @relation("Buyer")
  bonusHistory     BonusTransaction[]
  rewardHistory    RewardTransaction[]

  @@index([referredById])
  @@index([status])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model PointLedger {
  id        String    @id @default(cuid())
  userId    String
  type      PointType
  points    Int
  reason    String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model Activity {
  id             String         @id @default(cuid())
  title          String
  description    String?
  points         Int
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  userActivities UserActivity[]
}

model UserActivity {
  id         String         @id @default(cuid())
  userId     String
  activityId String
  status     ActivityStatus @default(PENDING)
  points     Int
  proof      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  activity   Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
  @@index([userId])
  @@index([activityId])
  @@index([status])
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum PointType {
  ACTIVITY
  REFERRAL
  BONUS
  ADJUSTMENT
  REVERSAL
}

enum ActivityStatus {
  PENDING
  APPROVED
  REJECTED
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        String   @default("string")
  category    String   @default("general")
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

model Announcement {
  id          String    @id @default(cuid())
  text        String
  isActive    Boolean   @default(true)
  order       Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  target      String?
  oldValue    String?
  newValue    String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([action])
}

model Purchase {
  id           String   @id @default(cuid())
  userId       String
  usdtAmount   Float
  tokenAmount  Float
  price        Float
  txHash       String?
  status       String   @default("COMPLETED")
  createdAt    DateTime @default(now())

  user         User     @relation("UserPurchases", fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model RewardDistribution {
  id           String   @id @default(cuid())
  earnerId     String
  buyerId      String
  level        Int
  rewardTokens Float
  rewardUSDT   Float
  status       String   @default("DISTRIBUTED")
  createdAt    DateTime @default(now())

  earner       User     @relation("Earner", fields: [earnerId], references: [id])
  buyer        User     @relation("Buyer", fields: [buyerId], references: [id])

  @@index([earnerId])
  @@index([buyerId])
  @@index([level])
}

// ============================================================
// ✅ NAYE MODELS (Phase 8)
// ============================================================

model BonusTransaction {
  id          String    @id @default(cuid())
  userId      String
  amount      Float
  type        String    // "SIGNUP", "PROMOTION", "REFERRAL", "ADMIN"
  status      String    @default("LOCKED") // "LOCKED", "RELEASED"
  reason      String?
  releasedAt  DateTime?
  releasedBy  String?
  txHash      String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([type])
}

model RewardTransaction {
  id          String    @id @default(cuid())
  userId      String
  amount      Float
  level       Int       // 1-5
  sourceId    String?
  status      String    @default("LOCKED")
  releasedAt  DateTime?
  releasedBy  String?
  txHash      String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([level])
}

model ReleaseHistory {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  type        String   // "BONUS", "REWARD", "BOTH"
  releasedBy  String
  txHash      String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([releasedBy])
}